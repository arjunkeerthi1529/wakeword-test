# Jarvis Voice Assistant systemd service
# Manages: wake word → STT → LLM → TTS conversation pipeline
#
# Install:
#   sudo cp scripts/jarvis-voice.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable jarvis-voice
#   sudo systemctl start jarvis-voice
#
# Depends on jarvis-agents.service being started first (Wants= + After=)
# so reminders forwarded via HTTP /remind always have a listener.

[Unit]
Description=Jarvis Voice Assistant (wake word + STT + LLM + TTS)
After=network.target sound.target jarvis-agents.service
Wants=jarvis-agents.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-voice-assistant

# Load environment from .env — same file the app reads with python-dotenv
EnvironmentFile=/home/pi/pi-voice-assistant/.env

ExecStart=/home/pi/pi-va-env/bin/python -m src.main

Restart=on-failure
RestartSec=5

StandardOutput=append:/home/pi/pi-voice-assistant/logs/voice.log
StandardError=append:/home/pi/pi-voice-assistant/logs/voice.log

[Install]
WantedBy=multi-user.target
