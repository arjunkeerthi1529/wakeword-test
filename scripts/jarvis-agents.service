# Jarvis Agent Service systemd unit
# Manages: email digest scheduler + reminder agent + REST API (:8001)
#
# Install:
#   sudo cp scripts/jarvis-agents.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable jarvis-agents
#   sudo systemctl start jarvis-agents
#
# Start this BEFORE jarvis-voice.service so the /remind endpoint is ready.

[Unit]
Description=Jarvis Agent Service (email digest + reminders, port 8001)
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-voice-assistant

EnvironmentFile=/home/pi/pi-voice-assistant/.env

ExecStart=/home/pi/pi-va-env/bin/python -m src.agent

Restart=on-failure
RestartSec=5

StandardOutput=append:/home/pi/pi-voice-assistant/logs/agents.log
StandardError=append:/home/pi/pi-voice-assistant/logs/agents.log

[Install]
WantedBy=multi-user.target
