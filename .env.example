# ─────────────────────────────────────────────────────────────────────────────
# Raspberry Pi Voice Assistant — environment variables
# Copy this file to .env and fill in your values.
# The app loads .env automatically on startup (via python-dotenv).
# ─────────────────────────────────────────────────────────────────────────────

# ── Voice pipeline ────────────────────────────────────────────────────────────

# URL of the running llama.cpp server (llama-server --port 8080)
LLM_BASE_URL=http://localhost:8080

# faster-whisper model: tiny.en | base.en | small.en (recommended on Pi 4)
STT_MODEL_NAME=small.en

# Path to the Piper TTS .onnx model file (run scripts/download_models.sh)
PIPER_VOICE=models/piper/en_US-lessac-low.onnx

# Wake word model name (hey_jarvis, hey_mycroft, alexa, etc.)
WAKE_MODEL=hey_jarvis

# Wake word detection sensitivity — lower = fewer false positives (0.0–1.0)
WAKE_THRESHOLD=0.35

# ALSA device for TTS playback. "auto" = pick the first USB/Jabra card.
# Find your card with: aplay -l  then use e.g. plughw:1,0
TTS_APLAY_DEVICE=auto

# ── Agent: Email Digest ───────────────────────────────────────────────────────

# Time to fetch and summarise emails each day (24-hour HH:MM)
EMAIL_FETCH_TIME=08:00

# Set to true to have Jarvis read the digest aloud after fetching
AGENT_READ_DIGEST=false

# "model" field sent with each summarise request. llama.cpp ignores this
# (serves one loaded model), but Ollama's OpenAI-compatible endpoint requires
# an actually-pulled model name here, e.g. llama3.2:3b.
LLM_MODEL=local

# Where an urgent/FYI "notify" draft is auto-sent (never the LLM's choice).
# A "reply" draft always goes back to the original sender instead, and always
# needs approval first -- see GET/POST /drafts.
AGENT_NOTIFY_EMAIL=me@example.com

# "mock" (default) logs the outbound email and marks it sent, without ever
# actually delivering it. Real SMTP sending is not implemented yet.
AGENT_SEND_MODE=mock

# ── Agent: Database ───────────────────────────────────────────────────────────

# SQLite database file path (created automatically)
AGENT_DB_PATH=data/agent.db

# ── Agent: Service link ───────────────────────────────────────────────────────

# Port the work service listens on  (python -m src.work)
AGENT_PORT=8001

# URL the voice assistant uses to reach the agent service
# Change only if running services on different machines
AGENT_SERVICE_URL=http://localhost:8001
